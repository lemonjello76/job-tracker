// Firestore Security Rules for mistamerica-job-tracker
//
// HOW TO APPLY:
//   1. Open https://console.firebase.google.com/project/mistamerica-job-tracker/firestore/rules
//   2. Replace whatever is there with the contents of this file (everything
//      after the "rules_version" line below).
//   3. Click "Publish".
//
// WHAT THIS DOES:
//   - Restricts all reads/writes to the single known user path used by the
//     app: /users/lyle-mistamerica/{drafts|jobs|trips|scans}/*
//   - Blocks every other path. An attacker who knows the project ID can no
//     longer probe for arbitrary collections.
//
// WHAT THIS DOES NOT DO:
//   - The hardcoded path 'lyle-mistamerica' is visible in the client source
//     (it's a public static site). Anyone who reads index.html can still
//     read/write that path. To truly lock the data down, you need Firebase
//     Auth — see "STRONGER OPTION" below.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow the app's known paths only.
    match /users/lyle-mistamerica/{collection}/{doc} {
      allow read, write: if true;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ────────────────────────────────────────────────────────────────────────
// STRONGER OPTION — requires a 10-line client change to add auth.
//
// In the Firebase console: Authentication → Sign-in method → enable
// "Email/Password" or "Google". Sign in once from your phone, then look up
// your Auth UID under Authentication → Users.
//
// Replace the rules above with:
//
//   rules_version = '2';
//   service cloud.firestore {
//     match /databases/{database}/documents {
//       match /users/{uid}/{collection}/{doc} {
//         allow read, write: if request.auth != null
//                            && request.auth.uid == "<YOUR-AUTH-UID-HERE>";
//       }
//       match /{document=**} { allow read, write: if false; }
//     }
//   }
//
// And in index.html, after firebase.initializeApp(firebaseConfig), add:
//
//   firebase.auth().onAuthStateChanged(user => {
//     if (!user) firebase.auth().signInWithEmailAndPassword(EMAIL, PASS);
//   });
//
// Then your data is locked to you and only you, regardless of who has the
// project ID. Worth doing if the job data is ever sensitive.
